NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sentinel
CLIENT_URL=http://localhost:5173

# Generate a long random value for each deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-16-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
AUTHORITY_INVITE_CODE=

AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=3
AI_RETRY_BASE_MS=2000

GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=SentinelSafetyPlatform/2.0 (set a contact email)
OVERPASS_URL=https://overpass-api.de/api/interpreter

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Fast2SMS Quick SMS (keep the API key server-side)
FAST2SMS_API_KEY=

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_OFFICIAL_ALERTS_URL=https://cap-sources.s3.amazonaws.com/in-imd-en/rss.xml
WEATHER_CACHE_MIN=15
WEATHER_STALE_MIN=120
