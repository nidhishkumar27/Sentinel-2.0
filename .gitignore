# Node.js dependencies and logs
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output, bundler caches, and test coverage
**/dist/
**/build/
**/out/
**/coverage/
**/.vite/
**/.next/
**/.nuxt/
**/.output/
**/storybook-static/

# Python bytecode, caches, environments, and package artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
*.egg-info/
wheels/
pip-wheel-metadata/
**/.venv/
**/venv/
**/ENV/
**/env/

# Local environment files and secrets; keep example templates trackable
**/.env*
!**/.env.example
!**/.env.*.example

# OS and editor-generated files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.history/
.vscode-test/
**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
